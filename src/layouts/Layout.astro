---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  hideFooter?: boolean;
  transparentNav?: boolean;
}

const {
  title = "Tamara Crespin",
  description = "Estudos judaicos, produtos culturais e afins",
  ogImage,
  hideFooter = false,
  transparentNav = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const mainLinks = [
  { href: "/projetos", label: "Projetos" },
  { href: "/sobre", label: "Sobre" },
];

const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL.href} />

    <!-- Google Fonts — Instrument Serif (citações/itálico) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=DM+Sans:wght@700&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <title>{title}</title>
  </head>

  <body
    class="min-h-screen flex flex-col"
    style={`background-color: var(--color-bg); color: var(--color-ink); font-family: var(--font-body);`}
  >
    <!-- ─── Nav ─── -->
    <nav
      id="main-nav"
      class="fixed top-0 left-0 right-0 z-50 px-4 sm:px-8 md:px-16 py-4 flex items-center justify-between"
      style={transparentNav ? "" : `background-color: var(--color-bg);`}
    >
      <a
        href="/"
        class="no-underline"
        style={`color: #000; font-family: var(--font-display); font-size: 1.2rem; font-weight: 600; letter-spacing: 0.01em; line-height: 1;`}
      >
        Tamara Crespin
      </a>

      <!-- Mobile toggle: ícone hambúrguer / fechar (animado via CSS) -->
      <button
        id="nav-toggle"
        class="md:hidden cursor-pointer bg-transparent border-none p-1 flex items-center justify-center"
        style={`color: var(--color-ink);`}
        aria-label="Abrir menu"
        aria-expanded="false"
      >
        <span class="nav-toggle-wrap" aria-hidden="true">
          <!-- Hambúrguer -->
          <svg class="nav-toggle-icon nav-toggle-icon--menu" width="22" height="18" viewBox="0 0 22 18" fill="none">
            <line x1="0" y1="2"  x2="22" y2="2"  stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <line x1="0" y1="9"  x2="22" y2="9"  stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <line x1="0" y1="16" x2="22" y2="16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <!-- Fechar -->
          <svg class="nav-toggle-icon nav-toggle-icon--close" width="18" height="18" viewBox="0 0 18 18" fill="none" style="left: 2px; top: 0;">
            <line x1="1" y1="1"  x2="17" y2="17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <line x1="17" y1="1" x2="1"  y2="17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </span>
      </button>

      <!-- Links desktop + mobile menu -->
      <ul id="nav-links" class="hidden md:flex gap-6 list-none m-0 p-0 items-center">

        <!-- Links principais -->
        {
          mainLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm no-underline transition-colors"
                style={`
                  color: #000;
                  font-family: var(--font-body);
                  font-weight: 600;
                  transition: color var(--transition-fast);
                `}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- ─── Main content ─── -->
    <main class="flex-1 pt-16">
      <slot />
    </main>

    <!-- ─── Footer ─── -->
    {!hideFooter && (
    <footer class="px-4 sm:px-8 md:px-16 py-6" />
    )}
    <style>
    </style>

    <script>
      const toggle = document.getElementById("nav-toggle");
      const links  = document.getElementById("nav-links");

      function openMenu() {
        links?.classList.remove("hidden");
        links?.classList.add("mobile-open", "flex", "flex-col", "px-6", "py-10");
        // Menu fullscreen: cobre o grafo completamente
        if (links) {
          links.style.position   = "fixed";
          links.style.top        = "3.5rem"; // nav height
          links.style.left       = "0";
          links.style.right      = "0";
          links.style.bottom     = "0";
          links.style.zIndex     = "49";
          links.style.backgroundColor = "var(--color-bg)";
        }
        // Força cor preta nos links (sobrepõe inline style do Astro)
        links?.querySelectorAll("a").forEach((a) => {
          (a as HTMLElement).style.color = "var(--color-ink)";
        });
        toggle?.setAttribute("aria-expanded", "true");
      }

      function closeMenu() {
        links?.classList.remove("mobile-open", "flex", "flex-col", "px-6", "py-10");
        links?.classList.add("hidden");
        if (links) {
          links.style.position = "";
          links.style.top      = "";
          links.style.left     = "";
          links.style.right    = "";
          links.style.bottom   = "";
          links.style.zIndex   = "";
          links.style.backgroundColor = "";
        }
        // Restaura cor original
        links?.querySelectorAll("a").forEach((a) => {
          (a as HTMLElement).style.color = "";
        });
        toggle?.setAttribute("aria-expanded", "false");
      }

      toggle?.addEventListener("click", () => {
        const isOpen = links?.classList.contains("mobile-open");
        isOpen ? closeMenu() : openMenu();
      });

      // Fechar ao clicar em um link
      links?.querySelectorAll("a").forEach((a) => {
        a.addEventListener("click", closeMenu);
      });
    </script>
  </body>
</html>
