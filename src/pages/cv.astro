<Layout
    title="CV — Tamara Crespin"
    description="Academic and professional CV of Tamara Crespin."
>

    <div class="cv-wrapper">

        <header class="cv-header">
            <div class="cv-title-row">
                <h1 class="cv-title">CV</h1>
                <a href="/about" class="cv-back-link">← about</a>
                <a href="/curriculo" class="cv-back-link">em português →</a>
            </div>
        </header>

        <!-- ─── About ─── -->
        <section class="cv-section">
            <p class="cv-intro">
                Tamara Crespin was born in 1999 and works in the Bom Retiro neighborhood
                of São Paulo, Brazil. She serves on the board of <a href="https://casadopovo.org.br/" target="_blank" rel="noopener noreferrer">Casa do Povo</a>, writes on
                memory, culture, and Jewish art for <a href="https://aj-la.org/" target="_blank" rel="noopener noreferrer">AJLA</a> (<em>Arte Judío
                Latino-americano</em>), and researches the territorialization of Jewish
                communities through the strategy of the eruv.
            </p>
        </section>

        <!-- ─── Academic Training ─── -->
        <section class="cv-section cv-section--ruled">
            <h2 class="cv-section-title">Academic Training</h2>
            <div class="cv-entries">

                <div class="cv-entry">
                    <span class="cv-year">2024–2026</span>
                    <div class="cv-entry-body">
                        <p class="cv-entry-main">Special student, Graduate Program in Modern Languages and Translation — FFLCH/USP</p>
                        <p class="cv-entry-sub">Affiliated with the Center for Jewish Studies</p>
                    </div>
                </div>

                <div class="cv-entry">
                    <span class="cv-year">2017–2023</span>
                    <div class="cv-entry-body">
                        <p class="cv-entry-main">Bachelor of Architecture and Urban Planning — Escola da Cidade</p>
                        <p class="cv-entry-sub">Exchange semester at UNAM, Mexico City, 2022</p>
                        <p class="cv-entry-sub">Thesis: <em>Jewish-Diasporic Perspectives on Place</em> (advisor: <a href="https://thiagobenucci.com/" target="_blank" rel="noopener noreferrer">Thiago Benucci</a>)</p>
                    </div>
                </div>

                <div class="cv-entry">
                    <span class="cv-year">2021–2022</span>
                    <div class="cv-entry-body">
                        <p class="cv-entry-main">Undergraduate research grant — Escola da Cidade</p>
                        <p class="cv-entry-sub">Advisor: Joana Barossi · <em>City Writing: Methodologies, Appropriations and Urban Translations</em></p>
