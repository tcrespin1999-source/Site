---
/**
 * RelatedItems.astro
 *
 * Exibe até 3 trabalhos com mais tags em comum com o item atual.
 * Ordena por: nº de tags compartilhadas desc, depois por data desc.
 * Todos os links apontam para a página interna do item.
 */

import { getCollection } from "astro:content";

interface Props {
    currentSlug: string;
    currentTags: string[];
}

const { currentSlug, currentTags } = Astro.props;

const allItems = await getCollection("trabalhos", ({ data }) => !data.draft);

const related = allItems
    .filter((item) => item.id.replace(/\.mdx?$/, "") !== currentSlug)
    .map((item) => ({
        slug: item.id.replace(/\.mdx?$/, ""),
        title: item.data.title,
        date: item.data.date ?? new Date(item.data.year ?? 0, 0, 1),
        sharedTags: item.data.tags.filter((t) => currentTags.includes(t)),
    }))
    .filter((item) => item.sharedTags.length > 0)
    .sort(
        (a, b) =>
            b.sharedTags.length - a.sharedTags.length ||
            b.date.getTime() - a.date.getTime(),
    )
    .slice(0, 3);
---

{
    related.length > 0 && (
        <aside
            style={`
                border-top: 1px solid var(--color-border);
                margin-top: 3rem;
                padding-top: 2rem;
            `}
        >
            <p
                style={`
                    font-family: var(--font-body);
                    font-size: 0.68rem;
                    color: var(--color-ink-muted);
                    letter-spacing: 0.14em;
                    text-transform: uppercase;
                    margin-bottom: 1.25rem;
                `}
            >
                — ver também
            </p>

            <ul
                style={`
                    list-style: none;
                    margin: 0;
                    padding: 0;
                    display: flex;
                    flex-direction: column;
                    gap: 1.25rem;
                `}
            >
                {related.map((item) => (
                    <li>
                        <a
                            href={`/trabalhos/${item.slug}`}
                            class="related-link"
                            style={`
                                font-family: var(--font-display);
                                font-size: 1rem;
                                color: var(--color-ink);
                                text-decoration: none;
                                line-height: 1.3;
                                display: block;
                            `}
                        >
                            {item.title}
                        </a>
                        <p
                            style={`
                                font-family: var(--font-body);
                                font-size: 0.75rem;
                                color: var(--color-ink-muted);
                                margin-top: 0.2rem;
                                line-height: 1.4;
                            `}
                        >
                            {item.sharedTags.join(" · ")}
                        </p>
                    </li>
                ))}
            </ul>
        </aside>
    )
}

<style>
    .related-link:hover {
        opacity: 0.55;
    }
</style>
