---
/**
 * ItemCard.astro
 *
 * Linha de item para /arquivo. Tipografia limpa, hierarquia clara.
 * Ano · Título · Venue · Tags (inline, mínimas)
 */

import TagList from "./TagList.astro";

interface Props {
    title: string;
    date: Date;
    venue?: string;
    tags: string[];
    url: string;
    externalUrl?: string;
    type: string;
    isClickable?: boolean;
}

const { title, date, venue, tags, url, externalUrl, isClickable = true } = Astro.props;

const year = date.getFullYear();
const href = externalUrl || url;
const isExternal = !!externalUrl;
---

<article class="item-card">
    {isClickable ? (
        <a
            href={href}
            class="item-link"
            target={isExternal ? "_blank" : undefined}
            rel={isExternal ? "noopener noreferrer" : undefined}
        >
            <div class="item-row">
                <span class="item-year">{year}</span>
                <div class="item-body">
                    <h3 class="item-title">
                        {title}{isExternal && <span class="item-external" aria-label="link externo">↗</span>}
                    </h3>
                    {venue && <p class="item-venue">{venue}</p>}
                </div>
            </div>
        </a>
    ) : (
        <div class="item-link item-link--static">
            <div class="item-row">
                <span class="item-year">{year}</span>
                <div class="item-body">
                    <h3 class="item-title">{title}</h3>
                    {venue && <p class="item-venue">{venue}</p>}
                </div>
            </div>
        </div>
    )}

    {tags.length > 0 && (
        <div class="item-tags">
            <TagList tags={tags} />
        </div>
    )}
</article>

<style>
    .item-card {
        padding: 1.5rem 0;
        border-bottom: 1px solid var(--color-border);
    }

    .item-link {
        display: block;
        text-decoration: none;
        color: var(--color-ink);
    }

    .item-row {
        display: flex;
        align-items: baseline;
        gap: 1.5rem;
    }

    .item-year {
        font-family: var(--font-body);
        font-size: 0.8rem;
        color: var(--color-ink-muted);
        font-variant-numeric: tabular-nums;
        flex-shrink: 0;
        width: 2.5rem;
        opacity: 0.5;
    }

    .item-body {
        flex: 1;
    }

    .item-title {
        font-family: var(--font-display);
        font-size: 1.2rem;
        font-weight: 400;
        line-height: 1.3;
        margin: 0;
        color: var(--color-ink);
        transition: opacity var(--transition-fast);
    }

    @media (min-width: 768px) {
        .item-title { font-size: 1.45rem; }
    }

    @media (min-width: 1280px) {
        .item-title { font-size: 1.6rem; }
    }

    .item-link:hover .item-title {
        opacity: 0.55;
    }

    .item-link--static {
        cursor: default;
    }

    .item-link--static .item-title {
        opacity: 0.45;
    }

    .item-external {
        font-size: 0.75em;
        margin-left: 0.25em;
        color: var(--color-ink-muted);
        vertical-align: super;
    }

    .item-venue {
        margin: 0.2rem 0 0;
        font-family: var(--font-body);
        font-size: 0.8rem;
        color: var(--color-ink-muted);
        font-style: italic;
        opacity: 0.7;
    }

    .item-tags {
        margin-top: 0.4rem;
        padding-left: calc(2.5rem + 1.5rem); /* year-width + gap */
    }
</style>
